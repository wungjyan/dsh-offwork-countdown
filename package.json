{
  "name": "dsh-offwork-countdown",
  "version": "1.0.1",
  "description": "A floating workday companion for the DeepSeek Harness Web UI: clock in, count down, get reminded when it is time to clock out. / 悬浮在界面角落的工作日流程挂件：上班打卡、下班倒计时、到点变色呼吸提醒。",
  "type": "module",
  "license": "MIT",
  "author": "wungjyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wungjyan/dsh-offwork-countdown.git"
  },
  "homepage": "https://github.com/wungjyan/dsh-offwork-countdown#readme",
  "bugs": {
    "url": "https://github.com/wungjyan/dsh-offwork-countdown/issues"
  },
  "engines": {
    "dsh": ">=0.1.7-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "countdown",
    "clock",
    "reminder"
  ],
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "img/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
